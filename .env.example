# Copy to .env and adjust. docker compose reads these automatically.

SHELFKEEP_USERNAME=admin
SHELFKEEP_PASSWORD=changeme
SESSION_SECRET=replace-with-a-long-random-string

# Used by docker compose. For a local (non-Docker) run you can omit this
# and Shelfkeep will use SQLite under ./data.
POSTGRES_USER=shelfkeep
POSTGRES_PASSWORD=shelfkeep
POSTGRES_DB=shelfkeep
DATABASE_URL=postgresql+psycopg://shelfkeep:shelfkeep@db:5432/shelfkeep
