# Copy to .env and adjust. docker compose reads these automatically.

SHELFKEEP_USERNAME=admin
SHELFKEEP_PASSWORD=changeme
# Leave blank to generate and persist a unique cookie-signing key under DATA_DIR.
# Do not use a documented placeholder — those are refused as signing keys.
SESSION_SECRET=

# Used by docker compose for the Postgres service. The app builds a
# URL-encoded DATABASE_URL from these values (so generated passwords
# with /, #, or ? still work). Do not set DATABASE_URL in .env for Compose.
POSTGRES_USER=shelfkeep
POSTGRES_PASSWORD=shelfkeep
POSTGRES_DB=shelfkeep

# Optional: for a local (non-Docker) run you can omit DATABASE_URL and
# Shelfkeep will use SQLite under ./data.
# DATABASE_URL=sqlite+pysqlite:///./data/shelfkeep.db
