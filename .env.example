# Copy to .env and adjust. docker compose reads these automatically.

SHELFKEEP_USERNAME=admin
SHELFKEEP_PASSWORD=changeme
SESSION_SECRET=replace-with-a-long-random-string

# Used by docker compose for the Postgres service. The app DATABASE_URL is
# assembled from these values (do not set DATABASE_URL in .env for Compose;
# a leftover SQLite URL from local dev would break the container).
POSTGRES_USER=shelfkeep
POSTGRES_PASSWORD=shelfkeep
POSTGRES_DB=shelfkeep

# Optional: for a local (non-Docker) run you can omit DATABASE_URL and
# Shelfkeep will use SQLite under ./data.
# DATABASE_URL=sqlite+pysqlite:///./data/shelfkeep.db
